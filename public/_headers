# Cloudflare picks this up automatically from the build output root (Vite
# copies everything in public/ to dist/ as-is). Docs:
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# CSP: scripts only from this origin (no inline scripts), data only to our Supabase project, media only from the
# Streamable CDN and Supabase Storage (signed deliverable URLs), images from
# Unsplash. Nothing may frame the site. Stripe Checkout and Google sign-in are
# full-page navigations, which CSP doesn't restrict. Adding a new third party
# (e.g. Turnstile: challenges.cloudflare.com in script-src + frame-src) means
# adding it here, or it will silently fail in production.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://images.unsplash.com https://arihkzzgylfmcqgdzjqf.supabase.co; media-src 'self' blob: https://*.streamable.com https://arihkzzgylfmcqgdzjqf.supabase.co; connect-src 'self' https://arihkzzgylfmcqgdzjqf.supabase.co wss://arihkzzgylfmcqgdzjqf.supabase.co; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
